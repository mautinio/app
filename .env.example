# Адрес трекера (можно с /admin_api/v1 или без) и API-ключ из Профиль → API ключи
KEITARO_URL=https://your-keitaro.example.com
KEITARO_API_KEY=
# true — работать со встроенным фейковым Keitaro (демо без доступа к трекеру)
KEITARO_MOCK=false
KEITARO_TIMEZONE=Europe/Moscow

# ID по умолчанию для создаватора (можно оставить пустыми и выбирать в форме)
DEFAULT_DOMAIN_ID=
DEFAULT_GROUP_ID=
DEFAULT_TRAFFIC_SOURCE_ID=

GEO_REDIRECT_URL=https://google.com
DATABASE_URL=sqlite+aiosqlite:///./testorator.db
